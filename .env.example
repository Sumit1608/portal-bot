# Copy this file to ".env" and fill in your real values.
# .env is ignored by git, so your secrets never reach GitHub.
GITHUB_USERNAME=your-username
GITHUB_PASSWORD=your-password
# The "setup key" GitHub shows when you enable 2FA (letters A-Z and digits 2-7)
GITHUB_TOTP_SECRET=PASTE_SETUP_KEY_HERE
# Optional: extra words to mask in logs and saved pages, comma-separated
# (for example your display name or email address)
REDACT_EXTRA=
